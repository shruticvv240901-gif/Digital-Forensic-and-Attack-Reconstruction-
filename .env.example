# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Project: AI-Assisted Automated Attack Timeline Reconstruction and Digital Forensic Reporting Using Splunk
#
# Instructions:
# 1. Copy this file to a new file named '.env':
#    cp .env.example .env   (or copy manually in Windows File Explorer / VS Code)
# 2. Fill in your specific Splunk connection settings below.
# 3. DO NOT commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Application Settings
# ------------------------------------------------------------------------------
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# ------------------------------------------------------------------------------
# Demonstration / Test Mode
# Set to 'True' to test the interface with clearly marked simulated data.
# Set to 'False' when you are ready to connect to your live Splunk Enterprise instance.
# ------------------------------------------------------------------------------
DEMO_MODE=True

# ------------------------------------------------------------------------------
# Splunk Enterprise Connection Details
# Note: The Splunk Enterprise REST API management port is typically 8089 (NOT 8000).
# Leave username/password/token blank until you are ready to configure them.
# ------------------------------------------------------------------------------
SPLUNK_HOST=localhost
SPLUNK_MANAGEMENT_PORT=8089
SPLUNK_SCHEME=https

# Authentication Option A: Splunk Username and Password
SPLUNK_USERNAME=
SPLUNK_PASSWORD=

# Authentication Option B: Splunk Bearer Token (preferred if configured in Splunk)
SPLUNK_BEARER_TOKEN=

# Splunk Enterprise default certificates on port 8089 are self-signed.
# Set to False to bypass SSL verification for local development, or True if using trusted CA certs.
SPLUNK_VERIFY_SSL=False

# Connection and search timeout in seconds
SPLUNK_TIMEOUT=15

# Search Index configuration: '*' searches all allowed indexes, or specify 'wineventlog' / 'main'
SPLUNK_INDEX=*

# Maximum number of event records to retrieve per query (default 100)
SPLUNK_SEARCH_MAX_COUNT=100
